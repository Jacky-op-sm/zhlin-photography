{
  "name": "zhlin-photography",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:deploy": "npm run verify",
    "start": "next start",
    "lint": "eslint src e2e tests scripts eslint.config.mjs next.config.js playwright.config.ts playwright.production.config.ts tailwind.config.js --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs && npm run check:writing",
    "check:assets": "node scripts/check-assets.mjs && npm run assets:check",
    "check:build-routes": "node scripts/check-build-routes.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "check:all-budgets": "npm run check:assets && npm run test:e2e:production -- runtime-budget.production.spec.ts --project=production-desktop",
    "verify:static": "npm run lint && npm run typecheck && npm run check:content && npm run check:assets",
    "verify": "npm run verify:static && npm run test:unit && npm run build",
    "photos:preview:street": "node scripts/sync-photography-selection.mjs --catalog workspace/photography/street-selection/catalog.json",
    "photos:publish:street": "node scripts/sync-photography-selection.mjs --catalog workspace/photography/street-selection/catalog.json --write",
    "assets:write": "node scripts/images/build.mjs --write",
    "assets:check": "node scripts/images/check.mjs",
    "assets:report": "node scripts/images/build.mjs",
    "assets:clean": "node scripts/images/build.mjs --clean",
    "test:e2e": "playwright test",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts",
    "test:e2e:production": "playwright test --config playwright.production.config.ts",
    "test:e2e:update": "playwright test --update-snapshots",
    "predev": "node scripts/prepare-writing.mjs --dev",
    "prebuild": "node scripts/prepare-writing.mjs",
    "check:writing": "node scripts/prepare-writing.mjs",
    "pretypecheck": "node scripts/prepare-writing.mjs"
  },
  "dependencies": {
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "js-yaml": "4.3.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "sharp": "0.35.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^20.12.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.25",
    "brace-expansion@1.1.16": "1.1.21",
    "brace-expansion@5.0.8": "5.0.12",
    "browserslist": "4.29.0",
    "js-yaml": "4.3.2",
    "postcss": "8.5.28",
    "postcss-selector-parser": "6.1.4",
    "sharp": "0.35.4"
  }
}
